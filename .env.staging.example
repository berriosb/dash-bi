# ─────────────────────────────────────────────────────────────────
# dash-bi staging environment variables (TEMPLATE)
#
# Copy this file to `.env.staging` on the staging host:
#
#   cp .env.staging.example .env.staging
#   chmod 600 .env.staging
#   chown root:root .env.staging
#
# Then substitute every `__PASTE_GENERATED__` and `__YOUR_DOMAIN__`
# placeholder with a real value. Generate each secret with the
# openssl one-liner shown in its comment.
#
# `docker compose` (root) and `scripts/smoke-staging.sh` BOTH refuse
# to start the stack if any of the `__PASTE_GENERATED__` markers are
# still present — there are no insecure fallback defaults.
# ─────────────────────────────────────────────────────────────────

# ─── Postgres (app role) ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
POSTGRES_USER=dashbi
POSTGRES_DB=dashbi
POSTGRES_PASSWORD=__PASTE_GENERATED__

# ─── Postgres (read-only role, used by AI-generated queries) ─────
# Generate with: openssl rand -base64 32
POSTGRES_READONLY_USER=dashbi_readonly
POSTGRES_READONLY_PASSWORD=__PASTE_GENERATED__

# ─── Redis (cache + BullMQ queue) ────────────────────────────────
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=__PASTE_GENERATED__

# ─── better-auth (sessions + magic-link signing) ──────────────────
# Generate with: openssl rand -hex 32   (must be >= 32 chars)
BETTER_AUTH_SECRET=__PASTE_GENERATED__
# Public URL the app is served from (no trailing slash)
BETTER_AUTH_URL=https://bi.__YOUR_DOMAIN__

# ─── PDF worker (shared secret between app and worker) ───────────
# Generate with: openssl rand -hex 16   (must be >= 16 chars)
PDF_WORKER_SECRET=__PASTE_GENERATED__
PDF_WORKER_URL=http://pdf-worker:3001
PUPPETEER_TIMEOUT_MS=30000
PUPPETEER_MAX_CONCURRENT=3

# ─── BYOK encryption (master key for LLM provider API keys) ─────
# Generate with: openssl rand -hex 32   (64 hex chars total)
LLM_KEY_ENCRYPTION_KEY=__PASTE_GENERATED__

# ─── Public app URL ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://bi.__YOUR_DOMAIN__

# ─── Email (Resend) ──────────────────────────────────────────────
# Sign up at https://resend.com — leave empty in dev to use the
# mock provider. In staging, this MUST be set or magic links silently
# fail to send.
EMAIL_PROVIDER=resend
RESEND_API_KEY=__PASTE_GENERATED__
EMAIL_FROM=dash-bi <noreply@__YOUR_DOMAIN__>

# ─── Google OAuth (Sheets connector) ─────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Optional: the app boots without these, but Sheets connector is
# disabled. Leave blank for staging smoke (no Sheets needed).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bi.__YOUR_DOMAIN__/api/auth/google/callback

# ─── Observability ───────────────────────────────────────────────
# Sentry DSN — leave blank to disable. Format: https://<key>@<org>.ingest.sentry.io/<id>
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
LOG_LEVEL=info

# ─── Docker ──────────────────────────────────────────────────────
# Host port the app listens on (Nginx terminates TLS upstream)
APP_PORT=3000
# Image tag — pin to a release tag, NOT `latest`
VERSION=v0.1.0