# ─────────────────────────────────────────────────────────────
# dash-bi root .gitignore
# Per-app ignores live in app/.gitignore. This file covers
# project-level artifacts that don't belong in version control.
# ─────────────────────────────────────────────────────────────

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
*.rej

# IDE / editor
.idea/
.vscode/
*.iml
.cursor/
.aider*
*.code-workspace

# Environment & secrets (NEVER commit)
.env
.env.*
!.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# Build / cache artifacts (top-level)
dist/
build/
out/
coverage/
.nyc_output/
.cache/
.turbo/
.tsbuildinfo
*.tsbuildinfo

# Node / package managers (top-level)
node_modules/
.pnpm-store/
.yarn/cache
.yarn/install-state.gz

# Test artifacts
test-results/
playwright-report/
playwright/.cache/
junit.xml
*.lcov

# Local data / volumes (mirrors app/.gitignore for root)
.pgdata/
.redisdata/
*.sqlite
*.sqlite-journal

# Docker / local infra overrides
docker-compose.override.yml
Dockerfile.local

# ─────────────────────────────────────────────────────────────
# Agent skills — keep ONE canonical location
# .opencode/skills/ is the project source of truth (loaded by
# opencode runtime). The .agents/ folder is reserved for
# future user-level skills and must not duplicate them.
# ─────────────────────────────────────────────────────────────
.agents/skills/
