# ─────────────────────────────────────────────────────────────
# dash-bi root .gitignore
# Per-app ignores live in app/.gitignore. This file covers
# project-level artifacts that don't belong in version control.
# ─────────────────────────────────────────────────────────────

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/
.Trash-*
.fseventsd/
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
*.rej
Session.vim

# IDE / editor
.idea/
.vscode/
*.iml
.cursor/
.aider*
*.code-workspace
.claude/
.continue/
.codeium/
.windsurf/
.kiro/
.mcp_config*

# Environment & secrets (NEVER commit)
.env
.env.*
!.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# Build / cache artifacts (top-level)
dist/
build/
out/
coverage/
.nyc_output/
.cache/
.turbo/
*.tsbuildinfo

# Linter / formatter / bundler caches
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache/
.swc/
htmlcov/
coverage-final.json

# Node / package managers (top-level)
node_modules/
.pnpm-store/
.yarn/cache
.yarn/install-state.gz

# Test artifacts
test-results/
playwright-report/
playwright/.cache/
junit.xml
*.lcov

# Local data / volumes (mirrors app/.gitignore for root)
.pgdata/
.redisdata/
*.sqlite
*.sqlite-journal

# Docker / local infra overrides
docker-compose.override.yml
Dockerfile.local

# Vercel deployments
.vercel

# Database dumps (defensive)
*.dump
*.sql.gz

# Tmp roots
tmp/
.tmp/

# ─────────────────────────────────────────────────────────────
# Agent skills — keep ONE canonical location
# .opencode/skills/ is the project source of truth (loaded by
# opencode runtime). The .agents/ folder is reserved for
# future user-level skills and must not duplicate them.
#
# Vendored third-party skill files (e.g. impeccable npm package
# copied under .opencode/skills/impeccable/) are gitignored to
# avoid bloating the repo. They are regenerated by contributors
# via `npx impeccable install` or `npx skills sync` (see
# docs/agent-skills.md).
#
# Only project-authored skills (e.g. security-audit) live in
# .opencode/skills/ and are tracked.
# ─────────────────────────────────────────────────────────────
.agents/skills/
.opencode/skills/impeccable/

# ─────────────────────────────────────────────────────────────
# AI planner state — ephemeral, regenerated on demand
# .hermes/ holds one-shot plans produced by the Hermes planner
# agent. Once a plan is executed and archived into docs/, the
# folder is no longer needed in git.
# ─────────────────────────────────────────────────────────────
.hermes/

# ─────────────────────────────────────────────────────────────
# Local dev tooling — per-developer, NOT committed
# Per project policy: the repo stores the application, not
# the developer's working setup. Each dev regenerates these.
# ─────────────────────────────────────────────────────────────
AGENTS.md
skills-lock.json
