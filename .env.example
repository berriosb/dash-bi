# ─────────────────────────────────────────────────────────────────
# dash-bi environment variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────────────────────────

NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
PORT=3000

# ─── Database ───────────────────────────────────────────────────────
# Rol de la APP: NOSUPERUSER NOBYPASSRLS. Un superuser ignora RLS por completo
# aunque la tabla tenga ENABLE + FORCE, así que este rol NO puede ser el mismo
# que POSTGRES_USER. PostgreSQL 15+ además impide degradar al bootstrap
# superuser, así que la separación tiene que ser de origen.
POSTGRES_APP_USER=dashbi_app
POSTGRES_APP_PASSWORD=changeme
DATABASE_URL=postgresql://dashbi_app:changeme@postgres:5432/dashbi
DATABASE_READONLY_URL=postgresql://dashbi_readonly:changeme@postgres:5432/dashbi

# Rol OWNER / migrations. Es superuser porque lo crea la imagen oficial, y eso
# es intencional: lo usa drizzle-kit para ser dueño de las tablas. La app no
# conecta con él.
# Para `pnpm db:migrate` usás esta, no DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://dashbi_owner:changeme@postgres:5432/dashbi

POSTGRES_DB=dashbi
POSTGRES_USER=dashbi_owner
POSTGRES_PASSWORD=changeme
POSTGRES_READONLY_USER=dashbi_readonly
POSTGRES_READONLY_PASSWORD=changeme
POSTGRES_PORT=5432

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_password@redis:6379
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# ─── Auth (better-auth) ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-32-byte-hex-secret-from-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth (for Sheets connector) ────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── Email ──────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=dash-bi <noreply@dash-bi.com>

# ─── Encryption (BYOK API keys) ─────────────────────────────────────
# Generate with: openssl rand -hex 32
LLM_KEY_ENCRYPTION_KEY=replace-with-32-byte-hex-key-from-openssl-rand-hex-32

# ─── Embed tokens (HMAC) ───────────────────────────────────────────
# Optional but recommended: a key dedicated to signing embed tokens, kept
# separate from the BYOK encryption key so rotating one does not invalidate
# the other. Falls back to LLM_KEY_ENCRYPTION_KEY, then BETTER_AUTH_SECRET.
# There is no built-in default on purpose — without a secret the embed
# routes refuse to sign or verify, rather than falling back to a value that
# is public in the repository.
# Generate with: openssl rand -hex 32
EMBED_TOKEN_SECRET=

# ─── PDF Worker (separate container) ────────────────────────────────
PDF_WORKER_URL=http://pdf-worker:3001
PDF_WORKER_SECRET=replace-with-random-shared-secret-min-16-chars
PUPPETEER_TIMEOUT_MS=30000
PUPPETEER_MAX_CONCURRENT=3

# ─── Monitoring (Sentry) ─────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ─── Docker ─────────────────────────────────────────────────────────
APP_PORT=3000
DOCKER_TARGET=production
