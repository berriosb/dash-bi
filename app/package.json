{
  "name": "dash-bi",
  "version": "0.1.0",
  "private": true,
  "description": "Open source BI platform with AI-genera-dashboards",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --grep @smoke --project=chromium",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:e2e:flake-check": "playwright test --repeat-each=3 --grep @critical",
    "test:security": "vitest run tests/security",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup-rls": "tsx scripts/setup-rls.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "worker:pdf": "tsx src/worker/index.ts",
    "worker:pdf:build": "tsc --project tsconfig.worker.json",
    "audit": "pnpm audit --audit-level=high",
    "audit:fix": "pnpm audit --fix",
    "audit:check": "node scripts/check-audit-baseline.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/openai": "^4.0.101",
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@sentry/nextjs": "^9.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@tremor/react": "^3.18.0",
    "@types/papaparse": "^5.5.2",
    "ai": "^7.0.152",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.6.22",
    "bullmq": "^5.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^4.9.0",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "googleapis": "^144.0.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.469.0",
    "mysql2": "^3.23.2",
    "next": "^16.4.3",
    "papaparse": "^5.5.4",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "puppeteer": "^24.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "recharts": "^2.15.0",
    "resend": "^4.0.0",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.6.0",
    "use-debounce": "^10.0.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^3.24.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testcontainers/postgresql": "^10.13.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "postcss": "^8.5.18",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "undici": "^6.28.1",
      "sharp": "^0.35.5",
      "postcss": "^8.5.23",
      "js-yaml": "^4.3.1",
      "fast-uri": "^3.1.5",
      "nanoid": "^3.3.18",
      "@grpc/grpc-js": "^1.14.5",
      "basic-ftp": "^6.2.1",
      "tinypool": "^2.1.2",
      "shell-quote": "^1.11.0",
      "source-map-js": "^1.2.2"
    }
  }
}
