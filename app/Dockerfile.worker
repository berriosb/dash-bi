# Dockerfile para PDF Worker (Puppeteer + Chrome).
#
# Sprint 1.5: este worker consume la cola `pdf-export` de BullMQ (Redis)
# y renderiza dashboards con Puppeteer. Corre como proceso separado
# del app principal para aislar el consumo de memoria y CPU.

FROM node:22-bookworm-slim AS base

# Install Chrome dependencies + Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates fonts-liberation libasound2 libatk-bridge2.0-0 libatk1.0-0 \
    libc6 libcairo2 libcups2 libdbus-1-3 libexpat1 libfontconfig1 libgbm1 \
    libgcc-s1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 \
    libpangocairo-1.0-0 libstdc++6 libx11-6 libx11-xcb1 libxcb1 libxcomposite1 \
    libxcursor1 libxdamage1 libxext6 libxfixes3 libxi6 libxrandr2 libxrender1 \
    libxss1 libxtst6 lsb-release wget xdg-utils chromium fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# pnpm
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

WORKDIR /app

# Install deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source. The worker is a tsx-runtime script (no separate build
# step required in production; the container is started with tsx).
# For a thinner image, compile to JS with `pnpm worker:pdf:build` and
# copy the compiled output here. We keep the tsx path for now to mirror
# the npm script and avoid drift between dev and prod.
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts

# Security: non-root
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker && \
    chown -R worker:nodejs /app
USER worker

ENV NODE_ENV=production
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

EXPOSE 3001

CMD ["pnpm", "worker:pdf"]