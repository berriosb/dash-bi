# ─────────────────────────────────────────────────────────────────
# dash-bi — Variables de entorno de ejemplo (.env.example)
# Ver docs/env-contract.md para la especificación canónica completa.
# ─────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LOG_LEVEL=info
PORT=3000

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://dashbi:dashbi_password@localhost:5432/dashbi
DATABASE_READONLY_URL=postgresql://dashbi_readonly:dashbi_readonly_password@localhost:5432/dashbi
POSTGRES_USER=dashbi
POSTGRES_PASSWORD=dashbi_password
POSTGRES_DB=dashbi

# Redis & Colas BullMQ
REDIS_URL=redis://:redis_password@localhost:6379

# Cifrado de credenciales BYOK (Master Key AES-256-GCM 64-hex chars)
LLM_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email / Notificaciones
EMAIL_PROVIDER=mock
EMAIL_FROM="dash-bi <noreply@dash-bi.com>"
RESEND_API_KEY=

# Proveedores de IA (Opcionales como fallback a nivel de sistema si la org no usa BYOK)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Exportación PDF (Worker Puppeteer)
PDF_WORKER_URL=http://localhost:3001
PDF_WORKER_SECRET=dev_pdf_worker_secret_123456
