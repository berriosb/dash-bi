# ─────────────────────────────────────────────────────────────────
# dash-bi environment variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────────────────────────

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
PORT=3000

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://dashbi:changeme@localhost:5432/dashbi
DATABASE_READONLY_URL=postgresql://dashbi_readonly:changeme@localhost:5432/dashbi
POSTGRES_DB=dashbi
POSTGRES_USER=dashbi
POSTGRES_PASSWORD=changeme
POSTGRES_READONLY_USER=dashbi_readonly
POSTGRES_READONLY_PASSWORD=changeme
POSTGRES_PORT=5432

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ─── Auth (better-auth) ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-32-byte-hex-secret-from-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth (for Sheets connector) ────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── Email ──────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=dash-bi <noreply@dash-bi.com>

# ─── Encryption (BYOK API keys) ─────────────────────────────────────
# Generate with: openssl rand -hex 32
LLM_KEY_ENCRYPTION_KEY=replace-with-32-byte-hex-key-from-openssl-rand-hex-32

# ─── PDF Worker (separate container) ────────────────────────────────
PDF_WORKER_URL=http://pdf-worker:3001
PDF_WORKER_SECRET=replace-with-random-shared-secret-min-16-chars
PUPPETEER_TIMEOUT_MS=30000
PUPPETEER_MAX_CONCURRENT=3

# ─── Monitoring (Sentry) ─────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─── Docker ─────────────────────────────────────────────────────────
APP_PORT=3000
DOCKER_TARGET=production