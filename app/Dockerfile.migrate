# One-shot image that applies pending Drizzle migrations, then exits.
#
# The app image is a Next.js `standalone` bundle: it carries no drizzle-kit,
# no `drizzle/` folder and no lockfile, so it cannot migrate. Without this
# service a deploy starts the new code against the old schema and every
# query touching a new column fails at runtime.
#
# It runs as a separate service (not a start script inside the app image)
# for two reasons: the migration role is the table owner
# (`DATABASE_MIGRATION_URL`), which must never be present in the long-lived
# app container, and Compose can gate `app` on this service exiting 0.

FROM node:22-alpine AS migrate
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml ./
COPY vendor ./vendor
RUN pnpm install --frozen-lockfile

COPY drizzle ./drizzle
COPY scripts ./scripts
COPY drizzle.config.ts tsconfig.json ./

# `drizzle-kit` reads DATABASE_MIGRATION_URL; RLS policies need the owner
# too. Running both in one container keeps the ordering explicit — schema
# first, then the policies that depend on the tables it just created.
CMD ["sh", "-c", "pnpm db:migrate && pnpm db:setup-rls"]